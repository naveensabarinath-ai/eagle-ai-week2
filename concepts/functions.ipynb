   "source": [
    "from modules.factorial import factorial\n",
    "\n",
    "def isPrime(num):\n",
    "    if num < 2:\n",
    "        return False\n",
    "    elif num % 2 == 0:\n",
    "        return False\n",
    "    else:\n",
    "        return True\n",
    "\n",
    "\n",
    "print(isPrime(11))\n",
    "\n",
    "print(isPrime(4))\n",
    "\n",
    "print(factorial(5))  # Output: 120\n"
   ]
  }
 ],
